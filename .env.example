# PLACEHOLDERS ONLY. Never commit a populated copy.
# Replit supplies managed values through Secrets and service configuration.
# Do not overwrite managed values with these placeholders.
NODE_ENV=development
PORT=8080
BASE_PATH=/
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_IN_SECRET_STORE
VITE_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Empty for development; Replit manages the production Clerk proxy setting.
VITE_CLERK_PROXY_URL=

AI_INTEGRATIONS_OPENAI_BASE_URL=REPLACE_WITH_PROVIDER_BASE_URL
AI_INTEGRATIONS_OPENAI_API_KEY=REPLACE_IN_SECRET_STORE

# Replit App Storage paths, supplied when storage is provisioned.
PRIVATE_OBJECT_DIR=/BUCKET_ID/.private
PUBLIC_OBJECT_SEARCH_PATHS=
